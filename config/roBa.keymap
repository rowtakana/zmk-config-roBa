#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    //automouse-layer = <4>;
    //scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        hash {
            bindings = <&kp HASH>;
            key-positions = <1 3 2>;
        };

        exqrametion {
            bindings = <&kp EXCLAMATION>;
            key-positions = <1 0>;
        };

        and {
            bindings = <&kp AMPERSAND>;
            key-positions = <12 13>;
        };

        question {
            bindings = <&kp QUESTION>;
            key-positions = <11 12 13>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <18 19>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <18 19 20>;
        };

        lkako {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <24 25>;
        };

        rkako {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <30 31>;
        };

        underbar {
            bindings = <&kp UNDERSCORE>;
            key-positions = <30 31 32>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <8 9>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <20 21>;
        };

        astarisc {
            bindings = <&kp ASTERISK>;
            key-positions = <13 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R  &kp T                                               &kp Y                     &kp U  &kp I      &kp O    &kp P
&mt LEFT_SHIFT A  &kp S         &kp D         &kp F  &kp G        &trans             &kp DOLLAR          &kp H                     &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z             &kp X         &kp C         &kp V  &kp B        &kp SQT            &kp AT_SIGN         &kp N                     &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &to 2  &lt 1 SPACE  &mt LCTRL F15      &mt LEFT_GUI ENTER  &mt LEFT_SHIFT BACKSPACE                             &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        custom {
            bindings = <
&kp F4     &kp LC(W)  &kp LG(E)     &trans     &kp LC(T)                          &kp GRAVE             &kp PAGE_UP       &kp UP_ARROW       &kp PAGE_DOWN  &trans
&kp LC(A)  &kp LC(S)  &kp LEFT_ALT  &kp TAB    &kp ESCAPE  &trans         &trans  &kp HOME              &kp LEFT          &kp DOWN           &kp RIGHT      &kp END
&kp LC(Z)  &kp LC(X)  &kp LC(C)     &kp LC(V)  &kp K_MENU  &kp CARET      &trans  &kp NON_US_BACKSLASH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans         &trans
&trans     &trans     &trans        &trans     &trans      &trans         &trans  &trans                                                                    &trans
            >;
        };

        num {
            bindings = <
&trans           &trans           &trans           &trans           &trans                               &trans           &trans           &trans           &trans           &trans
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &trans      &trans  &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0
&trans           &trans           &trans           &trans           &trans           &trans      &trans  &trans           &trans           &trans           &trans           &trans
&trans           &trans           &trans           &trans           &trans           &trans      &trans  &trans                                                              &trans
            >;
        };

        function {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp F12  &kp F12  &trans  &trans  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &kp F11
            >;
        };

        layer_4 {
            bindings = <
&bt BT_CLR  &bt BT_CLR_ALL  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans      &trans          &trans  &trans  &trans  &trans      &trans  &trans        &mkp MB1      &mkp MB2      &trans        &trans
&trans      &trans          &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans      &trans          &trans  &trans  &trans  &trans      &trans  &trans                                                  &trans
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
